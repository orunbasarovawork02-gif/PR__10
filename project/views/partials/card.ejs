<article class="card" data-place-id="<%= place.id %>">
    <% if (place.image) { %>
        <img
            src="/img/<%= encodeURIComponent(place.image) %>"
            alt="<%= place.title %>"
            class="card-image"
            onerror="this.style.display='none'"
        >
    <% } %>

    <div class="card-content">
        <p class="category"><%= place.category || "Достопримечательность" %></p>
        <h2><%= place.title %></h2>
        <p class="card-description"><%= place.description %></p>
        <a href="/place/<%= place.id %>" class="card-link">Подробнее →</a>

        <% if (isAdmin) { %>
            <div class="card-actions">
                <a href="/edit/<%= place.id %>" class="button button-small">Изменить</a>
                <button
                    type="button"
                    class="button button-small button-danger delete-place-button"
                    data-id="<%= place.id %>"
                >Удалить</button>
            </div>
        <% } %>
    </div>
</article>
