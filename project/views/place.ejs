<%- include("partials/head", { title: title }) %>
<body>

    <%- include("partials/header") %>

    <main class="container detail-page">
        <a href="/" class="back-link">← Назад к достопримечательностям</a>

        <article class="detail-card">
            <% if (place.image) { %>
                <img
                    src="/img/<%= encodeURIComponent(place.image) %>"
                    alt="<%= place.title %>"
                    class="detail-image"
                    onerror="this.style.display='none'"
                >
            <% } %>

            <p class="category">
                <%= place.category || "Достопримечательность" %>
            </p>

            <h1><%= place.title %></h1>
            <p><%= place.description %></p>

            <p>
                <strong>Время посещения:</strong>
                <%= place.time || "Не указано" %>
            </p>

            <% if (isAdmin) { %>
                <div class="card-actions">
                    <a href="/edit/<%= place.id %>" class="button button-small">Изменить</a>
                    <button
                        type="button"
                        class="button button-small button-danger delete-place-button"
                        data-id="<%= place.id %>"
                    >Удалить</button>
                </div>
            <% } %>
        </article>
    </main>

    <script src="/js/admin.js" defer></script>
</body>
</html>
